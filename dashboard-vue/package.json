{
  "name": "dashboard-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:e2e": "cypress run --config baseUrl=http://192.168.1.74:3000",
    "test:issues": "cypress run --spec cypress/e2e/issues.cy.js --config baseUrl=http://192.168.1.74:3000",
    "test:articles": "cypress run --spec cypress/e2e/articles.cy.js --config baseUrl=http://192.168.1.74:3000",
    "test:e2e:chrome": "cypress run --browser chrome --config baseUrl=http://192.168.1.74:3000",
    "test:issues:chrome": "cypress run --browser chrome --spec cypress/e2e/issues.cy.js --config baseUrl=http://192.168.1.74:3000",
    "test:articles:chrome": "cypress run --browser chrome --spec cypress/e2e/articles.cy.js --config baseUrl=http://192.168.1.74:3000",
    "test:merge-reports": "mochawesome-merge cypress/reports/*.json > cypress/reports/merged.json",
    "test:report": "npm run test:e2e && npm run test:merge-reports"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "@tiptap/extension-character-count": "^3.20.1",
    "@tiptap/extension-code-block-lowlight": "^3.20.1",
    "@tiptap/extension-collaboration": "^3.20.1",
    "@tiptap/extension-collaboration-cursor": "^3.0.0",
    "@tiptap/extension-image": "^3.20.1",
    "@tiptap/extension-placeholder": "^3.20.1",
    "@tiptap/pm": "^3.20.1",
    "@tiptap/starter-kit": "^3.20.1",
    "@tiptap/suggestion": "^3.20.1",
    "@tiptap/vue-3": "^3.20.1",
    "axios": "^1.13.2",
    "chart.js": "^4.5.1",
    "lowlight": "^3.3.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.24",
    "vue-router": "^4.6.3",
    "y-websocket": "^2.0.0",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@4tw/cypress-drag-drop": "^2.3.1",
    "@testing-library/cypress": "^10.1.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.22",
    "cypress": "^15.7.1",
    "cypress-multi-reporters": "^2.0.5",
    "happy-dom": "^20.0.11",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17",
    "vite": "^7.2.4",
    "vitest": "^4.0.15"
  }
}
