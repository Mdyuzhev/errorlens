# ErrorLens Backend Environment Variables

# Database (required)
DATABASE_URL=postgresql+asyncpg://errorlens:errorlens_secret@localhost:5432/errorlens

# LLM Provider: "gemini" or "groq"
LLM_PROVIDER=gemini

# API Keys
GEMINI_API_KEY=your-gemini-api-key
GROQ_API_KEY=your-groq-api-key

# Legacy admin key (for rate limit bypass)
ADMIN_KEY=your-admin-key

# JWT Authentication (REQUIRED for production!)
JWT_SECRET_KEY=your-super-secret-key-minimum-32-characters
ADMIN_PASSWORD=your-secure-admin-password

# Rate Limits
RATE_LIMIT_PER_DAY=10
