{
  "permissions": {
    "allow": ["Bash", "Read", "Write", "Edit", "Glob", "Grep", "WebFetch", "Task"]
  },
  "project": {
    "name": "ErrorLens",
    "production": "https://errorlens-production.up.railway.app",
    "repo": "github.com/Mdyuzhev/errorlens"
  },
  "stack": {
    "backend": "Python 3.11 + FastAPI + SQLAlchemy async",
    "database": "PostgreSQL (prod) / SQLite (dev)",
    "frontend": "Vue 3 + Vite + Pinia",
    "llm_providers": ["anthropic", "openai", "groq", "gemini", "ollama", "gigachat"]
  },
  "architecture": {
    "pattern": "Router → Service → Repository → Model",
    "websocket_state": "Redis or DB, not in-memory"
  },
  "code_requirements": {
    "python": {
      "type_hints": "required",
      "async_io": "required",
      "max_file_loc": 500,
      "bare_except": "prohibited"
    },
    "memory": {
      "cleanup": "required",
      "ttl_seconds": 3600,
      "max_items": 10000
    },
    "tests": {
      "unit": "required",
      "edge_cases": ["empty", "none", "duplicates"],
      "error_handling": "required",
      "concurrency": "required",
      "memory_leaks": "required"
    }
  },
  "git": {
    "main": "main",
    "current": "feature/wave-4",
    "commit_format": "[Wave X.Y] PX: Description"
  },
  "current_wave": {
    "number": "4.0",
    "name": "Sharmanka Migration",
    "phases": {
      "P1": {"name": "LLM Providers", "tasks": ["anthropic", "openai", "gigachat", "factory", "rate_limiter"]},
      "P2": {"name": "Input Parsers", "tasks": ["base", "har_input", "swagger_input"]},
      "P3": {"name": "Generator Core", "tasks": ["prompt_builder", "code_extractor", "test_validator", "llm_generator"]},
      "P4": {"name": "WebSocket", "tasks": ["manager", "generation_ws"]},
      "P5": {"name": "API", "tasks": ["generation_service", "generation_router"]},
      "P6": {"name": "Vue UI", "tasks": ["composable", "store", "components", "view"]},
      "P7": {"name": "Settings", "tasks": ["llm_settings"]}
    },
    "execution_order": ["P1", "P2", "P3", "P4", "P5", "P6", "P7"]
  },
  "instruction_format": {
    "contains": ["interface_signatures", "requirements", "prohibited_patterns", "test_cases"],
    "does_not_contain": ["full_implementations", "copy_paste_code"],
    "agent_behavior": "write_code_independently"
  },
  "quality_gates": {
    "before_commit": [
      "all_tests_pass",
      "no_bare_except",
      "memory_cleanup_exists",
      "concurrent_access_tested",
      "edge_cases_covered",
      "file_under_500_loc"
    ]
  },
  "prohibited": [
    "skip_phases",
    "copy_full_implementations",
    "bare_except",
    "in_memory_state_distributed",
    "commit_without_tests",
    "files_over_500_loc",
    "ask_confirmation"
  ]
}
