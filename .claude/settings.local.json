{
  "permissions": {
    "allow": [
      "Bash",
      "Read", 
      "Write",
      "Edit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Task",
      "TodoWrite",
      "NotebookEdit"
    ]
  },
  "preferences": {
    "language": "russian",
    "communication_style": "friendly_professional",
    "humor": {
      "enabled": true,
      "style": "добрый сарказм, айтишные шутки",
      "when": "в начале задачи, при успехе, при ошибках"
    },
    "formatting": {
      "emoji": false,
      "tables": true,
      "code_comments": "на английском",
      "commits": "[Story X.Y] description in English"
    }
  },
  "quick_start": {
    "description": "Читай документы ПО СИТУАЦИИ, не все подряд!",
    "always_read": [
      "ROADMAP.md"
    ],
    "by_task_type": {
      "backend": [
        "AGENT_INSTRUCTIONS.md",
        "backend/app/models.py"
      ],
      "frontend": [
        "AGENT_INSTRUCTIONS.md", 
        "bookmarklet/README.md"
      ],
      "any_task": [
        "AGENT_INSTRUCTIONS.md"
      ]
    }
  },
  "memory": {
    "project": "ErrorLens - bookmarklet для QA, анализ ошибок через AI",
    "stack": "Python/FastAPI backend, Vanilla JS bookmarklet, Gemini/Groq LLM",
    "hosting": "Railway/Vercel (backend), GitHub Pages (landing)",
    "repo": "https://github.com/Mdyuzhev/errorlens"
  },
  "git_workflow": {
    "main": "Прямой push (solo dev)",
    "process": "code → commit → push → close issue"
  },
  "task_workflows": {
    "story": {
      "naming": "[Story X.Y] Description",
      "after_complete": "gh issue close N --comment 'Completed'"
    },
    "epic": {
      "label": "epic",
      "contains": "checklist of stories"
    }
  },
  "critical_rules": [
    "Bookmarklet = vanilla JS, no dependencies, IIFE pattern",
    "Backend = FastAPI + Pydantic, async everywhere", 
    "LLM = Gemini primary, Groq fallback",
    "No database, stateless design",
    "CORS allow all (bookmarklet runs on any domain)"
  ],
  "tools": {
    "github": {
      "repo": "Mdyuzhev/errorlens",
      "cli": "gh"
    },
    "backend": {
      "run": "cd backend && uvicorn app.main:app --reload",
      "test": "cd backend && pytest"
    }
  }
}