{
  "permissions": {
    "allow": ["Bash", "Read", "Write", "Edit", "Glob", "Grep", "WebFetch", "Task"]
  },
  "project": {
    "name": "ErrorLens",
    "repo": "github.com/Mdyuzhev/errorlens"
  },
  "stack": {
    "backend": "Python 3.11 + FastAPI + SQLAlchemy async",
    "database": "PostgreSQL 16 (Docker, единственная БД)",
    "frontend": "Vue 3 + Vite 7 + Pinia + TailwindCSS 4",
    "llm_providers": ["anthropic", "openai", "groq", "gemini", "ollama", "gigachat"],
    "infrastructure": "Docker Compose (nginx + backend + postgres)"
  },
  "architecture": {
    "pattern": "Router → Service → Repository → Model",
    "websocket_state": "Redis or DB, not in-memory"
  },
  "code_requirements": {
    "python": {
      "type_hints": "required",
      "async_io": "required",
      "max_file_loc": 500,
      "bare_except": "prohibited"
    },
    "memory": {
      "cleanup": "required",
      "ttl_seconds": 3600,
      "max_items": 10000
    },
    "tests": {
      "unit": "required",
      "edge_cases": ["empty", "none", "duplicates"],
      "error_handling": "required",
      "concurrency": "required",
      "memory_leaks": "required"
    }
  },
  "git": {
    "main": "main",
    "commit_format": "[prefix] Описание на русском",
    "commit_prefixes": ["backend", "frontend", "docker", "infra", "docs", "test", "fix", "refactor"]
  },
  "instruction_format": {
    "contains": ["interface_signatures", "requirements_tables", "prohibited_patterns", "test_cases"],
    "does_not_contain": ["full_implementations", "copy_paste_code"],
    "agent_behavior": "write_code_independently"
  },
  "quality_gates": {
    "before_commit": [
      "all_tests_pass",
      "no_bare_except",
      "memory_cleanup_exists",
      "concurrent_access_tested",
      "edge_cases_covered",
      "file_under_500_loc"
    ]
  },
  "prohibited": [
    "skip_phases",
    "copy_full_implementations",
    "bare_except",
    "in_memory_state_distributed",
    "commit_without_tests",
    "files_over_500_loc",
    "ask_confirmation",
    "sqlite_usage"
  ]
}
