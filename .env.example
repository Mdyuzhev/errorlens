# Database (PostgreSQL)
POSTGRES_PASSWORD=errorlens_secret

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=errorlens
MINIO_ROOT_PASSWORD=errorlens_secret
MINIO_ENDPOINT=minio:9000

# LLM Provider: groq or gemini
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here

# Authentication
ADMIN_KEY=change_me_in_production
ADMIN_PASSWORD=change_me_in_production

# TestIt Integration (optional)
TESTIT_URL=https://your-instance.testit.software
TESTIT_TOKEN=your_testit_token_here
TESTIT_PROJECT_ID=your_project_guid_here
TESTIT_ENABLED=false
